{
  "expo": {
    "name": "PetrolSlip Pro",
    "slug": "petrolslip-pro",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fuelreceipt",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petrolslip.pro",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to thermal receipt printers.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to connect to thermal receipt printers.",
        "NSCameraUsageDescription": "This app uses the camera to capture your station logo.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to select a station logo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.petrolslip.pro",
      "versionCode": 2,
      "statusBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content",
        "translucent": false
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fuel Receipt to access your photos for station logo.",
          "cameraPermission": "Allow Fuel Receipt to use the camera for station logo."
        }
      ],
      "./plugins/withNyxPrinter.js",
      "./plugins/withSunmiPrinter.js",
      "./plugins/withUnifiedPrinter.js",
      "./plugins/withBluetoothRawPrinter.js",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0999c9dd-337c-4265-9914-7434b9e28915"
      }
    },
    "owner": "arslan_eas_2"
  }
}
